{
  "kind": "bm-profile",
  "framework_version": "1.1.0",
  "game_id": "four-alike",
  "title_ko": "끼리끼리",
  "template_id": "ad-first-interstitial",
  "genre_tag": "워드퍼즐",
  "plc_phase": "launch",
  "competitive": {
    "mode": "single"
  },
  "agentPurpose": "Four Alike(끼리끼리)의 수익화 프로필. 광고만 쓴다. 보상형은 플레이어가 고르는 네 자리(임시 칸 추가와 부스터 충전, 이어하기, 결과 2배)이고 전면은 판이 끝난 자리에서만 낸다. 결제 상품은 없다(사용자 결정 2026-11-21, DEC-002). 전면 광고에 광고 제거 상품을 함께 두는 조건(DEC-M03)의 예외이며 send-lane-duel(DEC-M19), Gather Puzzle(DEC-M22)과 같은 방식이다. 전면의 마찰은 빈도와 시점 제한, 원격 끄기 스위치로 다룬다. 일일 도전에서는 부스터와 이어하기 보상형을 끈다.",
  "markets": {
    "google_play": {
      "enabled": true
    },
    "app_store": {
      "enabled": false
    },
    "apps_in_toss": {
      "enabled": false
    }
  },
  "currencies": [
    {
      "id": "coin",
      "name_ko": "코인",
      "kind": "soft",
      "purchasable": false,
      "ad_earnable": true,
      "agentPurpose": "판 클리어, 일일 도전, 출석, 도감으로 버는 재화. 힌트, 되돌리기, 칸 추가와 카드 뒷면·테이블 테마에 쓴다. 팔지 않는다. 결과 창의 보상형은 그 판 코인을 2배로 만든다."
    }
  ],
  "hurdles": [
    {
      "hurdle_id": "slots_full",
      "type": "difficulty_spike",
      "where": {
        "kind": "progression",
        "milestone": "stage_6_onward"
      },
      "expected_first_encounter_min": 8,
      "free_path": {
        "kind": "grind",
        "description": "코인으로 되돌리기(80)나 칸 추가(150)를 사거나 판을 다시 시작한다. 하루 6판 이용자는 부스터 수요의 약 44%를 코인으로 충당한다(경제 시뮬, 가설)",
        "expected_minutes": 6
      },
      "paid_path": {
        "product_skus": [],
        "placement_ids": [
          "rewarded_booster"
        ],
        "expected_minutes": 1
      },
      "motives": [
        "insurance_continue"
      ],
      "agentPurpose": "임시 칸 2개가 가득 차 더 열 수 없는 순간이다. 모든 판은 2칸으로 풀리게 검증하지만 뒤집힌 카드를 모르고 넣은 선택으로 막힐 수 있다. 무작위 선택 성공률의 중앙값은 표준 배치에서 10%다(규칙 프로토타입 측정)."
    },
    {
      "hurdle_id": "mistake_limit",
      "type": "risk_loss",
      "where": {
        "kind": "progression",
        "milestone": "stage_21_onward"
      },
      "expected_first_encounter_min": 15,
      "free_path": {
        "kind": "skill",
        "description": "판을 다시 시작해 범주를 더 신중하게 추리한다",
        "expected_minutes": 3
      },
      "paid_path": {
        "product_skus": [],
        "placement_ids": [
          "rewarded_continue"
        ],
        "expected_minutes": 1
      },
      "motives": [
        "insurance_continue"
      ],
      "agentPurpose": "실수 4회로 판이 끝나는 순간이다. 이어하기는 실수 2회를 지우고 판당 한 번만 쓸 수 있다."
    },
    {
      "hurdle_id": "pair_unseen",
